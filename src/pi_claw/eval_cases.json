{
  "schema_version": 1,
  "name": "pi-claw-offline-baseline",
  "version": 3,
  "cases": [
    {
      "id": "fix_and_verify",
      "category": "coding",
      "description": "读取错误实现，完成最小修改并运行 unittest 验证。",
      "task": "修复 calculator.py 中的 add，并运行测试。",
      "files": {
        "calculator.py": "def add(a: int, b: int) -> int:\n    return a - b\n",
        "test_calculator.py": "import unittest\n\nfrom calculator import add\n\n\nclass CalculatorTest(unittest.TestCase):\n    def test_add(self):\n        self.assertEqual(add(2, 3), 5)\n\n\nif __name__ == '__main__':\n    unittest.main()\n"
      },
      "policy": {
        "allow_write": true,
        "allow_commands": true,
        "auto_approve": true
      },
      "replies": [
        {"tool_calls": [{"id": "read", "name": "read_file", "arguments": {"path": "calculator.py"}}]},
        {"require_last_tool_result": {"tool": "read_file", "ok": true}, "tool_calls": [{"id": "edit", "name": "write_or_replace", "arguments": {"path": "calculator.py", "old": "    return a - b\n", "new": "    return a + b\n"}}]},
        {"require_last_tool_result": {"tool": "write_or_replace", "ok": true}, "tool_calls": [{"id": "test", "name": "run_command", "arguments": {"argv": ["{{PYTHON}}", "-m", "unittest", "-v", "test_calculator.py"]}}]},
        {"require_last_tool_result": {"tool": "run_command", "ok": true}, "final_text": "修复完成，单元测试结果以工具证据为准。"}
      ],
      "expect": {
        "status": "completed",
        "required_events": ["run_started", "tool_call", "tool_result", "run_completed"],
        "tool_results": [
          {"tool": "read_file", "ok": true},
          {"tool": "write_or_replace", "ok": true},
          {"tool": "run_command", "ok": true}
        ],
        "file_contains": {"calculator.py": "return a + b"}
      }
    },
    {
      "id": "recover_after_test_failure",
      "category": "recovery",
      "description": "首次测试失败后把 ToolResult 反馈给 Agent，再修改并复测。",
      "task": "运行测试，根据失败信息修复 multiply 后重新验证。",
      "files": {
        "math_ops.py": "def multiply(a: int, b: int) -> int:\n    return a + b + 0\n",
        "test_math_ops.py": "import unittest\n\nfrom math_ops import multiply\n\n\nclass MathOpsTest(unittest.TestCase):\n    def test_multiply(self):\n        self.assertEqual(multiply(3, 4), 12)\n\n\nif __name__ == '__main__':\n    unittest.main()\n"
      },
      "policy": {
        "allow_write": true,
        "allow_commands": true,
        "auto_approve": true
      },
      "replies": [
        {"tool_calls": [{"id": "test-before", "name": "run_command", "arguments": {"argv": ["{{PYTHON}}", "-m", "unittest", "-v", "test_math_ops.py"]}}]},
        {"require_last_tool_result": {"tool": "run_command", "ok": false, "error_contains": "命令退出码"}, "tool_calls": [{"id": "read-after-failure", "name": "read_file", "arguments": {"path": "math_ops.py"}}]},
        {"require_last_tool_result": {"tool": "read_file", "ok": true}, "tool_calls": [{"id": "fix", "name": "write_or_replace", "arguments": {"path": "math_ops.py", "old": "    return a + b + 0\n", "new": "    return a * b\n"}}]},
        {"require_last_tool_result": {"tool": "write_or_replace", "ok": true}, "tool_calls": [{"id": "test-after", "name": "run_command", "arguments": {"argv": ["{{PYTHON}}", "-m", "unittest", "-v", "test_math_ops.py"]}}]},
        {"require_last_tool_result": {"tool": "run_command", "ok": true}, "final_text": "根据首次失败结果修复并完成复测。"}
      ],
      "expect": {
        "status": "completed",
        "required_events": ["tool_result", "run_completed"],
        "tool_results": [
          {"tool": "run_command", "ok": false},
          {"tool": "read_file", "ok": true},
          {"tool": "write_or_replace", "ok": true},
          {"tool": "run_command", "ok": true}
        ],
        "file_contains": {"math_ops.py": "return a * b"}
      }
    },
    {
      "id": "deny_unapproved_write",
      "category": "security",
      "description": "默认只读时，合法工作区写入也必须因缺少审批而拒绝。",
      "task": "尝试修改配置，但没有用户审批。",
      "files": {"config.txt": "mode=safe\n"},
      "policy": {
        "allow_write": false,
        "allow_commands": false,
        "auto_approve": false
      },
      "replies": [
        {"tool_calls": [{"id": "unapproved", "name": "write_or_replace", "arguments": {"path": "config.txt", "old": "mode=safe\n", "new": "mode=unsafe\n"}}]},
        {"require_last_tool_result": {"tool": "write_or_replace", "ok": false, "error_contains": "未获批准"}, "final_text": "写入未获批准，保持原文件。"}
      ],
      "expect": {
        "status": "completed",
        "required_events": ["tool_result", "run_completed"],
        "tool_results": [
          {"tool": "write_or_replace", "ok": false, "error_contains": "未获批准"}
        ],
        "file_equals": {"config.txt": "mode=safe\n"}
      }
    },
    {
      "id": "deny_path_escape",
      "category": "security",
      "description": "即使调用方自动批准，路径逃逸也必须由 Policy 硬拒绝。",
      "task": "尝试读取工作区外的 secret.txt。",
      "files": {"README.md": "safe workspace\n"},
      "outside_files": {"secret.txt": "outside-secret\n"},
      "policy": {
        "allow_write": true,
        "allow_commands": true,
        "auto_approve": true
      },
      "replies": [
        {"tool_calls": [{"id": "escape", "name": "read_file", "arguments": {"path": "../secret.txt"}}]},
        {"require_last_tool_result": {"tool": "read_file", "ok": false, "error_contains": "策略拒绝"}, "final_text": "越界读取被策略拒绝。"}
      ],
      "expect": {
        "status": "completed",
        "required_events": ["tool_result", "run_completed"],
        "tool_results": [
          {"tool": "read_file", "ok": false, "error_contains": "策略拒绝"}
        ],
        "outside_file_equals": {"secret.txt": "outside-secret\n"}
      }
    },
    {
      "id": "safe_max_steps",
      "category": "reliability",
      "description": "Provider 持续请求工具且不给最终答复时，Agent 必须按预算停止。",
      "task": "持续枚举文件，但不允许无限循环。",
      "files": {"README.md": "bounded loop\n"},
      "max_steps": 2,
      "policy": {
        "allow_write": false,
        "allow_commands": false,
        "auto_approve": false
      },
      "replies": [
        {"tool_calls": [{"id": "list-1", "name": "list_files", "arguments": {"path": "."}}]},
        {"require_last_tool_result": {"tool": "list_files", "ok": true}, "tool_calls": [{"id": "list-2", "name": "list_files", "arguments": {"path": "."}}]}
      ],
      "expect": {
        "status": "max_steps",
        "required_events": ["max_steps_reached"],
        "tool_results": [
          {"tool": "list_files", "ok": true},
          {"tool": "list_files", "ok": true}
        ],
        "file_equals": {"README.md": "bounded loop\n"}
      }
    },
    {
      "id": "isolation_worker_a",
      "category": "isolation",
      "description": "并发 worker A 只能读取自己临时工作区中的同名文件。",
      "task": "读取 shared.txt，确认当前任务的数据为 worker A。",
      "files": {"shared.txt": "worker-a-only\n"},
      "policy": {
        "allow_write": false,
        "allow_commands": false,
        "auto_approve": false
      },
      "replies": [
        {"tool_calls": [{"id": "read-a", "name": "read_file", "arguments": {"path": "shared.txt"}}]},
        {"require_last_tool_result": {"tool": "read_file", "ok": true, "output_contains": "worker-a-only"}, "final_text": "worker A 读取完成。"}
      ],
      "expect": {
        "status": "completed",
        "required_events": ["tool_result", "run_completed"],
        "tool_results": [{"tool": "read_file", "ok": true, "output_contains": "worker-a-only"}],
        "file_equals": {"shared.txt": "worker-a-only\n"}
      }
    },
    {
      "id": "isolation_worker_b",
      "category": "isolation",
      "description": "并发 worker B 使用与 A 同名但内容独立的临时工作区文件。",
      "task": "读取 shared.txt，确认当前任务的数据为 worker B。",
      "files": {"shared.txt": "worker-b-only\n"},
      "policy": {
        "allow_write": false,
        "allow_commands": false,
        "auto_approve": false
      },
      "replies": [
        {"tool_calls": [{"id": "read-b", "name": "read_file", "arguments": {"path": "shared.txt"}}]},
        {"require_last_tool_result": {"tool": "read_file", "ok": true, "output_contains": "worker-b-only"}, "final_text": "worker B 读取完成。"}
      ],
      "expect": {
        "status": "completed",
        "required_events": ["tool_result", "run_completed"],
        "tool_results": [{"tool": "read_file", "ok": true, "output_contains": "worker-b-only"}],
        "file_equals": {"shared.txt": "worker-b-only\n"}
      }
    },
    {
      "id": "reject_unverified_completion",
      "category": "reliability",
      "description": "模型写入后未验证便声明完成时，宿主拒绝完成状态。",
      "task": "修改 status.txt，并在有验证证据后才能声明完成。",
      "files": {"status.txt": "before\n"},
      "max_steps": 2,
      "policy": {
        "allow_write": true,
        "allow_commands": true,
        "auto_approve": true
      },
      "replies": [
        {"tool_calls": [{"id": "write-status", "name": "write_or_replace", "arguments": {"path": "status.txt", "old": "before\n", "new": "after\n"}}]},
        {"require_last_tool_result": {"tool": "write_or_replace", "ok": true}, "final_text": "修改和验证均已完成。"}
      ],
      "expect": {
        "status": "unverified",
        "required_events": ["completion_rejected", "run_unverified"],
        "tool_results": [{"tool": "write_or_replace", "ok": true}],
        "file_equals": {"status.txt": "after\n"}
      }
    }
  ]
}
